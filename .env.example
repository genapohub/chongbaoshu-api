# Sentry 配置
SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
SENTRY_ENV=production
SENTRY_RELEASE=1.1.0
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# API 性能监控
SLOW_REQUEST_THRESHOLD_MS=3000

# 微信模板消息（在微信公众平台「功能」→「模板消息」中申请模板ID）
WX_TEMPLATE_VACCINE=
WX_TEMPLATE_DEWORM=
WX_TEMPLATE_DUE=
WX_TEMPLATE_ANNOUNCE=

# 腾讯云短信（用于手机验证码登录）
SMS_SECRET_ID=
SMS_SECRET_KEY=
SMS_SDK_APP_ID=
SMS_TEMPLATE_ID=
SMS_SIGN=宠宝树
