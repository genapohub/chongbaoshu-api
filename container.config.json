{
  "containerName": "chongbaoshu-api",
  "dockerfilePath": "Dockerfile",
  "buildDir": "",
  "port": 80,
  "cpu": 1,
  "mem": 2,
  "minReplicas": 1,
  "maxReplicas": 3,
  "policyType": "cpu",
  "policyThreshold": 70,
  "envs": {
    "ENV": "production",
    "DEV_MODE": "false",
    "PORT": "80",
    "JWT_ALGORITHM": "HS256",
    "CORS_ORIGINS": "*",
    "MAX_UPLOAD_SIZE_MB": "5",
    "SLOW_REQUEST_THRESHOLD_MS": "3000"
  },
  "logs": {
    "enable": true,
    "logType": "json"
  }
}
